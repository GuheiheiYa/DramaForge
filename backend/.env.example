# DramaForge 后端环境变量配置
# 复制此文件为 .env 并填入实际值

# ─── HTTP 服务（与前端 app/.env 中 VITE_API_ORIGIN 端口保持一致）───
API_HOST=127.0.0.1
API_PORT=7790

# ─── 数据库 ───
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dramaforge
SQLITE_URL=sqlite+aiosqlite:///./dramaforge.db

# ─── Redis ───
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── LLM API Keys ───
# MiMo（小米大模型）— 代码读取 APP_MIMO_API_KEY
APP_MIMO_API_KEY=your-mimo-api-key
MIMO_API_KEY=your-mimo-api-key
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Claude（可选）
CLAUDE_API_KEY=
# OpenAI（可选）
OPENAI_API_KEY=

# ─── 图像/视频生成 API Keys ───
# Agnes AI（图像 + 视频生成）
AGNES_API_KEY=your-agnes-api-key
AGNES_BASE_URL=https://apihub.agnes-ai.com
AGNES_MODEL=agnes-image-2.1-flash
AGNES_VIDEO_MODEL=agnes-video-v2.0

# 即梦AI（可选）
JIMENG_API_KEY=
JIMENG_BASE_URL=

# 可灵AI（可选）
KLING_API_KEY=

# ─── TTS 配音 ───
# 火山引擎TTS
VOLC_TTS_APP_ID=
VOLC_TTS_ACCESS_TOKEN=

# ─── 文件存储 ───
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800

# ─── CORS ───
CORS_ORIGINS=["*"]

# ─── 开发模式 ───
DEBUG=true
